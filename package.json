{
  "name": "sql-agent-eval",
  "version": "0.1.0",
  "description": "A reliability harness for text-to-SQL agents: execute the agent's SQL, compare its result to ground truth, and measure whether the evaluation catches the failures it should. Deterministic verdict, confident-but-wrong tracking, gold-SQL mutation testing.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "report": "tsx src/cli.ts report",
    "live": "tsx src/cli.ts live"
  },
  "keywords": [
    "text-to-sql",
    "llm",
    "reliability",
    "eval",
    "duckdb",
    "data",
    "llm-as-judge"
  ],
  "author": "Thomas Labarriere <t.labarriere12@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^2.1.3",
    "eslint": "^9.13.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.5",
    "openai": "^4.68.0"
  }
}
